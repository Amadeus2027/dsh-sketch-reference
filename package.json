{
  "name": "dsh-sketch-reference",
  "version": "0.4.0",
  "description": "DeepSeek Harness 原生可视化协作：可编辑草图、参考输入与 Agent 批注",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "REUSE.md",
    "THIRD_PARTY_NOTICES.md",
    "third_party_licenses",
    "docs",
    "CONTRIBUTING.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-alpha.1": "unknown"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bundle": "tsc -p tsconfig.build.json && tsdown --config tsdown.config.ts && vite build && node build/copy-excalidraw-fonts.mjs && node build/generate-third-party-notices.mjs",
    "dev:editor": "vite --host 127.0.0.1",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:browser:comments": "node tests/browser-comments.mjs",
    "test:model-comparison": "node tests/model-comparison.mjs",
    "test:browser:native": "node tests/browser-native.mjs",
    "test:performance": "node tests/browser-performance.mjs",
    "test:browser:agent": "node tests/browser-agent.mjs",
    "test:browser:edits": "node tests/browser-edits.mjs",
    "test:browser:focus": "node tests/browser-focus.mjs",
    "test:browser:visual": "node tests/browser-visual.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-chat": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
